# Firebase client configuration (Vite exposes only VITE_* values to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel server-only variables for /api/post-facebook
# Never prefix these with VITE_ and never commit real values.
FB_PAGE_ID=
FB_ACCESS_TOKEN=
FB_GRAPH_VERSION=v26.0

